     :gate/source "eta-mu/package.json"}
    {:gate/id :eta-mu/unit
     :gate/kind :unit
     :gate/execution :local
     :gate/command ["bb" "scripts/test.bb"]
     :gate/source "eta-mu/package.json"}
    {:gate/id :eta-mu/build
     :gate/kind :build
     :gate/execution :local
     :gate/command ["pnpm" "-r" "--no-bail" "build"]
     :gate/source "eta-mu/package.json"}]}

