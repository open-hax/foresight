           :environment {"HOME" "<other>/home" "TMPDIR" "<other>/tmp" "GOTMPDIR" "<other>/gotmp" "GOCACHE" "<cache>" "GOMODCACHE" "<immutable-modcache>" "GOENV" "off" "GOWORK" "off" "GOTOOLCHAIN" "local" "GOPROXY" "off" "GOSUMDB" "off" "GOVCS" "*:off" "GOTELEMETRY" "off" "CGO_ENABLED" "0" "GOMAXPROCS" "1"}
           :environment-rule "Empty inherited environment; add only reviewed fixed locale/platform settings. Private mod/sum must be the exact accepted reviewed pair; no lockfile edits, downloads, credentials or shared-cache writes."
