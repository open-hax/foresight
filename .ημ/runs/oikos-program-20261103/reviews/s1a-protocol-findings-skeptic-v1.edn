          {:file "src/oikos/infra/bb_render.cljs" :lines [117 126] :reason "Only decoder-normalized strings reach accept-response; nonzero stderr byte count is not checked on success."}
          {:file "src/oikos/law/frame.cljc" :lines [18 18] :reason "BOM is not permitted intertoken whitespace."}
          {:file "src/oikos/law/generation.cljc" :lines [265 277] :reason "Direct validator rejects BOM-prefixed frame and nonempty stderr when the BOM character is preserved."}]
   :frozen-contract [{:file "docs/specs/s1a-generation-contracts.md" :lines [290 296] :requirement "Exactly one specified UTF-8 EDN frame followed by EOF."}
                     {:file "docs/specs/s1a-generation-contracts.md" :lines [317 324] :requirement "No prefix banners/trailing non-whitespace; success stderr must be empty."}]
