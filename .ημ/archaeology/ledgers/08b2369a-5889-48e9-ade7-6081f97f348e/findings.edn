{:event/id "37eb5885-a226-4ec3-bb78-43994e8f80ab" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:08b2369a-5889-48e9-ade7-6081f97f348e" :event/seq 1 :event/causes ["08b2369a-5889-48e9-ade7-6081f97f348e"] :event/actor "agent:chatgpt" :event/subject "archaeology:08b2369a-5889-48e9-ade7-6081f97f348e" :event/at "2026-09-20T13:07:22Z" :event/data {:finding/id :knoxx/actor-message-route-completion-preserves-both-coordinates :finding/shapes #{:routing :resolution :domain-algorithm :identity} :finding/current-name "resolve-session-conversation! + send-control!" :finding/candidate-name "CoRequiredRouteCompletion<Session,Conversation>" :finding/claim "Actor-message control routing treats a session-only address as incomplete: resolve-session-conversation! may derive a missing conversation id from the session store, but it preserves the session id and send-control! rejects unless both conversation_id and session_id are present. This is address completion, not ProgressiveRouteBinding: learning the conversation does not revoke or replace the session coordinate, so the WebSocket weak-to-strong refinement law does not generalize to this ingress path."}}
{:event/id "8a61a7fd-a03f-4a32-827e-5d8a8113241c" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:08b2369a-5889-48e9-ade7-6081f97f348e" :event/seq 2 :event/causes ["37eb5885-a226-4ec3-bb78-43994e8f80ab"] :event/actor "agent:chatgpt" :event/subject "archaeology:08b2369a-5889-48e9-ade7-6081f97f348e" :event/at "2026-09-20T13:07:22Z" :event/data {:finding/id :knoxx/actor-mailbox-route-is-lease-qualified-owner-projection :finding/shapes #{:routing :projection :lease :store :lifecycle} :finding/current-name "actor_mailbox_routes" :finding/candidate-name "LeaseQualifiedOwnerRoute<Owner,Route>" :finding/claim "The actor mailbox persists at most one current route per actor_id, replacing conversation/session/run metadata on conflict while stamping active status, expiry, and last_seen_at. Resolution accepts only active, unexpired rows and chooses the latest observed route. This is a lease-qualified owner-to-address projection, not OwnerKeyedHandleCache: no live socket handle is cached and liveness is represented explicitly as route state."}}
{:event/id "126dca04-752e-4299-b71c-ea3814717a99" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:08b2369a-5889-48e9-ade7-6081f97f348e" :event/seq 3 :event/causes ["8a61a7fd-a03f-4a32-827e-5d8a8113241c"] :event/actor "agent:chatgpt" :event/subject "archaeology:08b2369a-5889-48e9-ade7-6081f97f348e" :event/at "2026-09-20T13:07:22Z" :event/data {:finding/id :knoxx/explicit-occurrence-address-dominates-owner-route :finding/shapes #{:routing :resolver :precedence :domain-algorithm} :finding/current-name "resolve-actor-route!" :finding/candidate-name "ExplicitRoutePrecedence<Direct,Derived>" :finding/claim "Actor route lookup is attempted only when an actor id is present and both conversation and session coordinates are absent. Explicit occurrence coordinates therefore dominate the mutable owner projection; derived current-route state fills a missing address instead of overwriting a direct target. The same missing-only discipline appears when conversation resolution skips lookup once a conversation id is already present."}}
