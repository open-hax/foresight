{:event/id "00fabc23-7e2b-4ec1-aece-8807449f5cef" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:ad2a7cf9-1bec-4757-9288-c1a5f0582b5e" :event/seq 1 :event/causes ["ad2a7cf9-1bec-4757-9288-c1a5f0582b5e"] :event/actor "agent:chatgpt" :event/subject "archaeology:ad2a7cf9-1bec-4757-9288-c1a5f0582b5e" :event/at "2026-09-13T13:35:47Z" :event/data {:finding/id :knoxx/realtime-route-binding-refines-session-to-conversation :finding/shapes #{:scope :routing :identity :runtime} :finding/current-name "ws-client-matches-payload? + set_conversation" :finding/candidate-name "ProgressiveRouteBinding<WeakId,StrongId>" :finding/claim "Realtime delivery treats conversation identity as authoritative once both sides know it, while session identity is only a provisional fallback when the client has not yet learned the server-generated conversation id. The frontend persists the latest conversation id across reconnects and sends one in-band rebinding message when an open socket learns a new id. This is monotonic route-authority refinement, not a generic fallback chain: learning the stronger id disables the weaker match for scoped payloads."}}
{:event/id "bbae8a5b-d129-4393-9480-32e5a679b778" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:ad2a7cf9-1bec-4757-9288-c1a5f0582b5e" :event/seq 2 :event/causes ["00fabc23-7e2b-4ec1-aece-8807449f5cef"] :event/actor "agent:chatgpt" :event/subject "archaeology:ad2a7cf9-1bec-4757-9288-c1a5f0582b5e" :event/at "2026-09-13T13:35:47Z" :event/data {:finding/id :knoxx/realtime-clients-are-occurrence-indexed :finding/shapes #{:registry :lifecycle :identity :runtime} :finding/current-name "ws-clients*" :finding/candidate-name "ConnectionOccurrenceIndex<OccurrenceId,Endpoint>" :finding/claim "Each accepted realtime WebSocket receives a fresh random client id and is stored under that connection occurrence, while session/conversation routing metadata may mutate in place and close/error removes the occurrence. The map therefore indexes live connection occurrences rather than logical users, sessions, resources, or executable implementations; calling it a generic Registry would erase the identity and removal laws."}}
{:event/id "f2fb6101-790a-4b6a-a2de-56255be11b2e" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:ad2a7cf9-1bec-4757-9288-c1a5f0582b5e" :event/seq 3 :event/causes ["bbae8a5b-d129-4393-9480-32e5a679b778"] :event/actor "agent:chatgpt" :event/subject "archaeology:ad2a7cf9-1bec-4757-9288-c1a5f0582b5e" :event/at "2026-09-13T13:35:47Z" :event/data {:finding/id :knoxx/twitch-connections-are-owner-keyed-handle-cache :finding/shapes #{:cache :driver :lifecycle :runtime} :finding/current-name "twitch-connections" :finding/candidate-name "OwnerKeyedHandleCache<Owner,Handle>" :finding/claim "Twitch keeps at most one process-local WebSocket handle per credential username and reuses it for send/join calls until a close callback evicts that owner key. The code stores the socket before open, does not validate readyState before reuse, and error only logs, so the structure is a best-effort owner-keyed handle cache rather than a liveness-certified connection registry. This contrasts directly with the occurrence-keyed realtime subscriber index despite both being long-lived atom maps of sockets."}}
