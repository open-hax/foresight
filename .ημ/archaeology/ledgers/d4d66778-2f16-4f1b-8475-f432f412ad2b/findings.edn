{:event/id "01c2f5bd-50ff-4f2e-ad76-0bb50b577918" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:d4d66778-2f16-4f1b-8475-f432f412ad2b" :event/seq 1 :event/causes ["d4d66778-2f16-4f1b-8475-f432f412ad2b"] :event/actor "agent:chatgpt" :event/subject "archaeology:d4d66778-2f16-4f1b-8475-f432f412ad2b" :event/at "2026-09-12T13:33:13Z" :event/data {:finding/id :knoxx/live-progress-fanout-is-process-local :finding/shapes #{:fanout :registry :mailbox :infra} :finding/current-name "kms-ingestion.api.event-bus subscribers + LinkedBlockingQueue" :finding/candidate-name "LiveFanoutHub<Key,Mailbox>" :finding/claim "The ingestion progress bus is a process-local registry from job id to per-subscriber mailboxes. Each subscription receives a fresh FIFO queue, broadcasts copy each live event to every current subscriber, and unsubscribe removes the mailbox and then the empty job entry. The bus provides no replay or durable authority; its law is live fanout plus explicit subscriber lifetime."}}
