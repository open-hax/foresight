{:event/id "f9d91ace-af68-4d72-aa54-6bba9400cfc3" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:03f0493a-6162-4112-8d84-89b8cb1d4451" :event/seq 1 :event/causes ["03f0493a-6162-4112-8d84-89b8cb1d4451"] :event/actor "agent:chatgpt" :event/subject "archaeology:03f0493a-6162-4112-8d84-89b8cb1d4451" :event/at "2026-09-21T13:43:46Z" :event/data {:finding/id :knoxx/current-turn-binding-is-generation-fenced-not-leased :finding/shapes #{:registry :cell :lifecycle :capability-boundary} :finding/current-name "active-turns* + register-active-turn! + unregister-active-turn!" :finding/candidate-name "GenerationFencedCurrentBinding<Owner,Generation,Handle>" :finding/claim "The voice turn-control plane keeps one process-local current entry per conversation. Registration replaces the current entry, while run-qualified unregistration removes it only when the supplied run id still matches the registered generation, preventing an older turn from revoking a newer owner. The map is intentionally lost on restart and has no expiry or renewal clock, so it pressure-tests LeaseQualifiedOwnerRoute as a distinct non-lease current-binding law."}}
{:event/id "47a82b4a-ba12-49fd-8b6c-539aed2ca05f" :event/schema {:schema/root "8eb19ab0e4b70e205a84a627fd3e15c3ba79c0fd8c792d37e72f3c79511e0bf9" :schema/id :archaeology/finding-recorded :schema/hash "f2ad682fa2ac851a5d18b436849d3c59f07eb5f9ebe6179d231d7254b8d89848"} :event/type :archaeology/finding-recorded :event/stream "archaeology:findings:03f0493a-6162-4112-8d84-89b8cb1d4451" :event/seq 2 :event/causes ["f9d91ace-af68-4d72-aa54-6bba9400cfc3"] :event/actor "agent:chatgpt" :event/subject "archaeology:03f0493a-6162-4112-8d84-89b8cb1d4451" :event/at "2026-09-21T13:43:46Z" :event/data {:finding/id :knoxx/current-turn-liveness-is-repaired-from-runtime-observation :finding/shapes #{:reconciler :projection :lifecycle :domain-algorithm} :finding/current-name "clear-ghost-turn! + runtime-processing-session?" :finding/candidate-name "ObservedLivenessRepair<Binding,Observation>" :finding/claim "Route recovery does not infer active-turn validity from age. The app checks the underlying agent session for active streaming or a current turn and unregisters the process-local control binding when neither is observed. Liveness is therefore repaired by observation of another runtime authority, not by TTL lease expiry; a generic lease abstraction would erase that recovery law."}}
