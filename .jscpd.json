{
  "reporters": ["console", "json"],
  "output": "reports/jscpd",
  "gitignore": true,
  "noSymlinks": true,
  "ignore": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-dev/**",
    "**/target/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.shadow-cljs/**",
    "**/.clj-kondo/.cache/**",
    "**/.lsp/**",
    "**/.cpcache/**",
