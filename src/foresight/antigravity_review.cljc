(ns foresight.antigravity-review
  "Portable declaration, selection, and rendering for Antigravity review callers."
  (:require [clojure.string :as str]
            [foresight.project :as project]))

(def workflow-path ".github/workflows/antigravity-review.yml")
(def generator-marker
  "# Generated by scripts/antigravity_rollout.clj; managed Antigravity review caller.")
(def canonical-workflow-repository "open-hax/eta-mu")
(def compatibility-workflow-repository "octave-commons/muse")
(def workflow-repositories
  #{canonical-workflow-repository compatibility-workflow-repository})
(def prior-pull-request-actions ["opened" "synchronize" "reopened" "ready_for_review" "edited"])
(def pull-request-actions
  ["opened" "synchronize" "reopened" "ready_for_review" "converted_to_draft" "edited"])
(def edit-review-predicate
  "github.event.action != 'edited' || github.event.changes.base.ref.from != ''")
(def prior-review-condition
  (str "${{ github.event.pull_request.draft == false && (" edit-review-predicate ") }}"))
(def review-condition
  (str "${{ github.event.pull_request.head.repo.full_name == github.repository && "
       "github.event.pull_request.draft == false && (" edit-review-predicate ") }}"))
(def concurrency-suffix
  (str "-${{ (" edit-review-predicate ") && 'review' || github.run_id }}"))

(defn review-event?
  "Accept same-repository review events; skip fork/missing heads, drafts and unrelated edits."
  [{:keys [action pull_request changes repository]}]
  (boolean
    (and (string? (:full_name repository)) (seq (:full_name repository))
         (= (:full_name repository) (get-in pull_request [:head :repo :full_name]))
         (false? (:draft pull_request))
         (contains? (set pull-request-actions) action)
         (or (not= "edited" action)
             (let [previous-base (get-in changes [:base :ref :from])]
               (and (string? previous-base) (seq previous-base)))))))

(defn revision?
  "True only for an immutable lowercase, full-length Git commit SHA."
  [value]
  (boolean (and (string? value) (re-matches #"[0-9a-f]{40}" value))))

(defn targets
  "Include the root and actionable independent direct members, in declaration order."
  [sources]
  (into [{:path "." :repository "open-hax/foresight"}]
        (comp (filter #(and (= :git-submodule (:source/type %))
                            (= :independent-repository (:source/ownership %))
                            (true? (:source/actionable? %))
                            (not (:source/consolidation? %))))
              (map #(hash-map :path (:source/path %)
                              :repository (:source/repository %))))
        sources))

(defn select-targets
  "Resolve an optional explicit selection without widening the declared member set."
  [declared {:keys [all? only]}]
  (when (and all? only)
    (throw (ex-info "Choose exactly one of --all or --only" {})))
  (let [known (set (map :path declared))]
    (when (and only (or (empty? only) (not-every? known only)))
      (throw (ex-info "--only contains an undeclared or non-actionable target"
                      {:only only :allowed known})))
    (if only
      (filterv #(contains? (set only) (:path %)) declared)
      (vec declared))))

(defn- render-template [revision runtime-revision workflow-repository format-version]
   (when-not (and (revision? revision) (revision? runtime-revision))
     (throw (ex-info "Workflow/runtime revisions must be exact lowercase 40-character commit SHAs" {})))
   (when-not (contains? workflow-repositories workflow-repository)
     (throw (ex-info "Workflow repository must be eta-mu or its reviewed Muse compatibility mirror" {})))
   (str generator-marker "\n"
       "name: Antigravity evidence review\n\n"
       "on:\n  pull_request:\n"
       "    types: [" (str/join ", " (case format-version
                                          :initial (pop prior-pull-request-actions)
                                          :current pull-request-actions
                                          prior-pull-request-actions)) "]\n\n"
       "permissions:\n  contents: read\n  pull-requests: read\n\n"
       "concurrency:\n"
       "  group: antigravity-review-${{ github.workflow }}-${{ github.event.pull_request.number }}"
       (when (contains? #{:prior-current :current} format-version) concurrency-suffix) "\n"
       "  cancel-in-progress: true\n\n"
       "jobs:\n  review:\n"
       "    if: " (case format-version
                    :initial "${{ github.event.pull_request.draft == false }}"
                    :current review-condition
                    prior-review-condition) "\n"
       "    uses: " workflow-repository "/.github/workflows/antigravity-code-review.yml@" revision "\n"
       "    with:\n"
       "      pr_head_sha: ${{ github.event.pull_request.head.sha }}\n"
       "      pr_base_sha: ${{ github.event.pull_request.base.sha }}\n"
       "      review_runtime_revision: " runtime-revision "\n"
       "      model: gemini-3.8-flash-high\n"))

(defn render-workflow
  "Render the managed caller, reviewing base retargets while ignoring other PR edits."
  ([revision] (render-workflow revision revision))
  ([revision runtime-revision]
   (render-workflow revision runtime-revision canonical-workflow-repository))
  ([revision runtime-revision workflow-repository]
   (render-template revision runtime-revision workflow-repository :current)))

(defn workflow-status
  "Distinguish absence, exact match, owned revision drift, and unknown file content."
  ([actual revision] (workflow-status actual revision revision))
  ([actual revision runtime-revision]
   (workflow-status actual revision runtime-revision canonical-workflow-repository))
  ([actual revision runtime-revision workflow-repository]
   (let [expected (render-workflow revision runtime-revision workflow-repository)
        [_ prior-repository prior-revision]
        (when (string? actual)
          (re-find #"uses: ([^\s]+)/\.github/workflows/antigravity-code-review\.yml@([0-9a-f]{40})\n"
                   actual))
        prior-runtime (when (string? actual)
                        (second (re-find #"review_runtime_revision: ([0-9a-f]{40})\n" actual)))]
    (cond
      (nil? actual) :absent
      (= actual expected) :matching
      (and (revision? prior-revision) (revision? prior-runtime)
           (contains? workflow-repositories prior-repository)
           (some #(= actual (render-template prior-revision prior-runtime prior-repository %))
                 [:initial :retarget :prior-current :current])) :revision-mismatch
      :else :unmanaged))))

(defn route-targets
  "Route by declared repository organization, keeping the runtime pin owned by eta-mu."
  [selected {:keys [revision octave-revision]}]
  (when-not (revision? revision)
    (throw (ex-info "--revision must be an exact lowercase 40-character commit SHA" {})))
  (mapv (fn [{:keys [repository] :as target}]
          (let [organization (first (str/split repository #"/"))
                [workflow-repository workflow-revision]
                (case organization
                  "open-hax" [canonical-workflow-repository revision]
                  "octave-commons"
                  (if (revision? octave-revision)
                    [compatibility-workflow-repository octave-revision]
                    (throw (ex-info "--octave-revision must be an exact lowercase 40-character commit SHA when Octave Commons members are selected" {})))
                  (throw (ex-info "Repository organization has no reviewed workflow route"
                                  {:repository repository})))]
            (assoc target :workflow-repo workflow-repository
                          :workflow-revision workflow-revision)))
        selected))

(defn- unique-option [options key value]
  (when (contains? options key)
    (throw (ex-info (str "Duplicate option: " (name key)) {})))
  (assoc options key value))

(defn- checkout-option [options value]
  (let [[_ member checkout] (re-matches #"([^=]+)=(/.+)" value)]
    (when-not (and member checkout (not (str/includes? checkout "\u0000")))
      (throw (ex-info "--checkout requires member=/absolute/worktree" {})))
    (when (contains? (:checkouts options) member)
      (throw (ex-info (str "Duplicate checkout override: " member) {})))
    (assoc-in options [:checkouts member] checkout)))

(defn parse-options
  "Parse plan/check/apply options and require explicit mutation scope and pinned revision."
  [[command & args]]
  (when-not (contains? #{"plan" "check" "apply"} command)
    (throw (ex-info "Expected plan, check, or apply" {})))
  (let [options
        (loop [remaining args options {:command command}]
          (if-let [flag (first remaining)]
            (if (= "--all" flag)
              (recur (rest remaining) (unique-option options :all? true))
              (let [value (second remaining)]
                (when (or (nil? value) (str/starts-with? value "--"))
                  (throw (ex-info (str flag " requires a value") {})))
                (recur (nnext remaining)
                       (case flag
                         "--root" (unique-option options :root value)
                         "--revision" (unique-option options :revision value)
                         "--octave-revision" (unique-option options :octave-revision value)
                         "--runtime-revision" (unique-option options :runtime-revision value)
                         "--only" (unique-option options :only (str/split value #"," -1))
                         "--checkout" (checkout-option options value)
                         (throw (ex-info (str "Unknown option: " flag) {}))))))
            options))
        selected (select-targets (targets project/sources) options)
        selected-paths (set (map :path selected))]
    (when-not (revision? (:revision options))
      (throw (ex-info "--revision must be an exact lowercase 40-character commit SHA" {})))
    (when (and (contains? options :runtime-revision)
               (not (revision? (:runtime-revision options))))
      (throw (ex-info "--runtime-revision must be an exact lowercase 40-character commit SHA" {})))
    (when (and (contains? options :octave-revision)
               (not (revision? (:octave-revision options))))
      (throw (ex-info "--octave-revision must be an exact lowercase 40-character commit SHA" {})))
    (when (and (= "apply" command) (not (or (:all? options) (:only options))))
      (throw (ex-info "apply requires --only <paths> or --all" {})))
    (when-not (every? selected-paths (keys (:checkouts options)))
      (throw (ex-info "--checkout overrides must name declared selected targets" {})))
    (route-targets selected options)
    options))
